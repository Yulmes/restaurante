// Esquema de datos de Marea Baja (M2). Diseño: propuesta §6, §6.1, §6.2, §6.3, §7 y §8.
//
// Convenciones:
// - Montos: enteros en la unidad menor ISO 4217 de la moneda (`…Minor`). Nunca decimales.
// - Tasas: puntos básicos (`rateBps`, 1300 = 13,00 %).
// - Textos: el es-CR vive en la entidad principal; las tablas `…Translation` guardan el resto (D2).
// - Lo que Prisma no expresa (CHECK, índice funcional, trigger y grants) está en el SQL de las
//   migraciones y se verifica con los tests de restricciones (`apps/api/test`).

generator client {
  provider               = "prisma-client"
  output                 = "../src/generated/prisma"
  runtime                = "nodejs"
  moduleFormat           = "esm"
  generatedFileExtension = "ts"
  importFileExtension    = "ts"
}

datasource db {
  provider = "postgresql"
}

// ─── Enumeraciones ──────────────────────────────────────────────────────────

/// Idiomas soportados (D2). Coinciden con `LOCALES` de @marea-baja/shared.
enum Locale {
  es_CR @map("es-CR")
  en
}

/// Monedas (§6.2). Coinciden con `CURRENCIES` de @marea-baja/shared.
enum Currency {
  CRC
  USD
}

enum RoleKey {
  CUSTOMER
  STAFF
  ADMIN
}

/// Tipos de entrega de un pedido. Solo retiro y delivery (D4, C10).
enum FulfillmentType {
  PICKUP
  DELIVERY
}

/// Ámbito de un impuesto o cargo. `DINE_IN` existe solo para el cargo de servicio inactivo (C10).
enum ServiceScope {
  PICKUP
  DELIVERY
  DINE_IN
}

enum TaxBase {
  ITEMS
  DELIVERY
  BOTH
}

/// Etiquetas de la línea de carta, siempre con texto (§3.6).
enum DietaryTag {
  SPICY
  GLUTEN_FREE
  VEGETARIAN
}

enum ImageProvider {
  STATIC
  CLOUDINARY
  R2
}

enum PromotionKind {
  PERCENT
  FIXED_AMOUNT
}

/// Máquina de estados del pedido (§7.1). Las transiciones las valida la API (M7).
enum OrderStatus {
  PENDING_PAYMENT
  PENDING_CONFIRMATION
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

/// Máquina de estados del pago (§7.2).
enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  AUTHORIZED
  CAPTURED
  PARTIALLY_REFUNDED
  REFUNDED
  VOIDED
  PENDING_COLLECTION
  COLLECTED
}

enum PaymentMethod {
  DEMO_CARD
  CASH_ON_DELIVERY
}

/// Escenarios del selector de pago demo (§7.4).
enum DemoScenario {
  APPROVED
  DECLINED
  INSUFFICIENT_FUNDS
  PROCESSOR_ERROR
  TIMEOUT
  PENDING
}

enum PaymentAttemptResult {
  SUCCEEDED
  FAILED
  PENDING
  UNKNOWN
}

enum PaymentOperationType {
  AUTHORIZE
  CAPTURE
  VOID
  REFUND
}

enum PaymentOperationStatus {
  REQUESTED
  SUCCEEDED
  FAILED
  UNKNOWN
}

enum MockTransactionState {
  PENDING
  AUTHORIZED
  DECLINED
  CAPTURED
  VOIDED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// Estados honestos del correo (§8.5).
enum EmailStatus {
  QUEUED
  SENT
  DEMO_ONLY
  FAILED
}

// ─── Identidad (§8) ─────────────────────────────────────────────────────────

/// El correo es único sin distinguir mayúsculas: índice funcional `lower(email)` en la migración.
model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String
  passwordHash    String
  name            String
  phone           String?
  /// Idioma de los correos y de la interfaz por defecto (D2).
  locale          Locale    @default(es_CR)
  /// Pagar exige un correo verificado (D3).
  emailVerifiedAt DateTime?
  blockedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  roles                   UserRole[]               @relation("UserRoles")
  rolesGranted            UserRole[]               @relation("RoleGrantedBy")
  sessions                Session[]
  addresses               Address[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  cart                    Cart?
  orders                  Order[]
  statusChanges           OrderStatusHistory[]
  refunds                 Refund[]
  auditEntries            AuditLog[]
  emails                  EmailOutbox[]
  idempotencyKeys         IdempotencyKey[]
}

model Role {
  id    String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key   RoleKey    @unique
  users UserRole[]
}

model UserRole {
  userId      String   @db.Uuid
  roleId      String   @db.Uuid
  grantedById String?  @db.Uuid
  grantedAt   DateTime @default(now())

  user      User  @relation("UserRoles", fields: [userId], references: [id], onDelete: Cascade)
  role      Role  @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedBy User? @relation("RoleGrantedBy", fields: [grantedById], references: [id], onDelete: SetNull)

  @@id([userId, roleId])
}

/// Solo se guarda SHA-256 del token (§8.2).
model Session {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String    @db.Uuid
  tokenHash         String    @unique
  csrfSecret        String
  createdAt         DateTime  @default(now())
  lastSeenAt        DateTime  @default(now())
  idleExpiresAt     DateTime
  absoluteExpiresAt DateTime
  rotatedAt         DateTime?
  revokedAt         DateTime?
  ipHash            String?
  userAgent         String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Tokens de un solo uso guardados como hash (§8.7).
model EmailVerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model PasswordResetToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @db.Uuid
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

/// Bloqueos temporales escalonados de login (§8.4). `subjectKey`: cuenta+IP o cuenta.
model LoginLock {
  subjectKey  String   @id
  lockedUntil DateTime
  level       Int      @default(1)
  updatedAt   DateTime @updatedAt
}

/// Rate limiting persistente con ventana fija (§8.4).
model RateLimitCounter {
  key         String
  windowStart DateTime
  count       Int      @default(1)

  @@id([key, windowStart])
  @@index([windowStart])
}

model Address {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String   @db.Uuid
  label     String
  line1     String
  line2     String?
  district  String
  canton    String
  province  String
  /// Referencia para el repartidor ("Portón negro, casa esquinera").
  reference String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Catálogo (§3.6, §4.5) ──────────────────────────────────────────────────

model Category {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug        String   @unique
  /// Nombre en es-CR (fuente). El inglés vive en `CategoryTranslation`.
  name        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  translations CategoryTranslation[]
  products     Product[]
}

model CategoryTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId  String  @db.Uuid
  /// Nunca `es-CR`: ese texto vive en `Category` (CHECK en la migración).
  locale      Locale
  name        String
  description String?

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  categoryId     String       @db.Uuid
  /// Igual en los dos idiomas: el nombre original del plato se conserva (§4.2, D2).
  slug           String       @unique
  /// Nombre original del plato.
  name           String
  description    String
  basePriceMinor Int
  tags           DietaryTag[]
  /// Desactivado: no aparece en la carta.
  isActive       Boolean      @default(true)
  /// Disponible o "Agotado hoy" (§3.6). La v1 no gestiona existencias por unidad.
  isAvailable    Boolean      @default(true)
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  category     Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations ProductTranslation[]
  images       ProductImage[]
  optionGroups ProductOptionGroup[]
  taxRates     ProductTaxRate[]
  cartItems    CartItem[]
  orderItems   OrderItem[]

  @@index([categoryId, isActive])
}

model ProductTranslation {
  id          String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId   String  @db.Uuid
  locale      Locale
  /// Solo cuando el nombre original es descriptivo y conviene traducirlo (§4.5).
  name        String?
  description String
  /// Texto alternativo de la foto principal en este idioma (§6.1).
  altText     String?

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

/// No guarda URL completa: la arma el `ImageStorageProvider` al leer (§9.4).
model ProductImage {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId  String        @db.Uuid
  provider   ImageProvider
  storageKey String
  width      Int
  height     Int
  /// Texto alternativo en es-CR. El inglés vive en `ProductTranslation.altText`.
  alt        String
  sortOrder  Int           @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([provider, storageKey, productId])
  @@index([productId, sortOrder])
}

model ProductOptionGroup {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId String  @db.Uuid
  name      String
  minSelect Int     @default(0)
  maxSelect Int     @default(1)
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  product      Product                  @relation(fields: [productId], references: [id], onDelete: Cascade)
  translations OptionGroupTranslation[]
  options      ProductOption[]

  @@index([productId])
}

model OptionGroupTranslation {
  id      String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId String @db.Uuid
  locale  Locale
  name    String

  group ProductOptionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, locale])
}

model ProductOption {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId         String  @db.Uuid
  name            String
  priceDeltaMinor Int     @default(0)
  isDefault       Boolean @default(false)
  isAvailable     Boolean @default(true)
  sortOrder       Int     @default(0)

  group           ProductOptionGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  translations    OptionTranslation[]
  cartItemOptions CartItemOption[]

  @@index([groupId])
}

model OptionTranslation {
  id       String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  optionId String @db.Uuid
  locale   Locale
  name     String

  option ProductOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  @@unique([optionId, locale])
}

/// Pizarra de pesca del día (§3.6). Los nombres de especies y puertos son nombres propios.
model CatchOfTheDay {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  date        DateTime  @unique @db.Date
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  items CatchItem[]
}

model CatchItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  catchId   String   @db.Uuid
  species   String
  port      String
  arrivedAt DateTime
  sortOrder Int      @default(0)

  catch CatchOfTheDay @relation(fields: [catchId], references: [id], onDelete: Cascade)

  @@index([catchId])
}

// ─── Configuración, impuestos y zonas (§6.2, D5) ────────────────────────────

/// Una sola fila (CHECK `id = 1` en la migración).
model RestaurantSettings {
  id                       Int      @id @default(1)
  currency                 Currency @default(CRC)
  pricesIncludeTax         Boolean  @default(true)
  roundingIncrementMinor   Int
  minOrderMinor            Int
  pickupEnabled            Boolean  @default(true)
  deliveryEnabled          Boolean  @default(true)
  timezone                 String   @default("America/Costa_Rica")
  isDemo                   Boolean  @default(true)
  /// Umbral global de fallos de login que activa Turnstile (D8).
  turnstileGlobalThreshold Int
  turnstileWindowMinutes   Int
  /// Concurrencia optimista para los cambios desde el admin.
  version                  Int      @default(0)
  updatedAt                DateTime @updatedAt

  openingHours OpeningHours[]
}

/// Horario por día (0 = domingo … 6 = sábado), en minutos desde la medianoche local.
model OpeningHours {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  settingsId    Int    @default(1)
  dayOfWeek     Int
  opensMinutes  Int
  closesMinutes Int

  settings RestaurantSettings @relation(fields: [settingsId], references: [id], onDelete: Cascade)

  @@unique([settingsId, dayOfWeek, opensMinutes])
}

model TaxRate {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Clave estable para la semilla y el admin (`iva`, `servicio`).
  key              String         @unique
  name             String
  rateBps          Int
  appliesTo        TaxBase
  fulfillmentTypes ServiceScope[]
  isActive         Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  products      ProductTaxRate[]
  orderTaxLines OrderTaxLine[]
}

/// Relación muchos a muchos Product ↔ TaxRate (§6).
model ProductTaxRate {
  productId String @db.Uuid
  taxRateId String @db.Uuid

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  taxRate TaxRate @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  @@id([productId, taxRateId])
}

model DeliveryZone {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key        String   @unique
  name       String
  /// Distritos que cubre la zona (nombres propios).
  districts  String[]
  feeMinor   Int
  etaMinutes Int
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)

  orders Order[]
}

model Promotion {
  id               String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code             String        @unique
  kind             PromotionKind
  /// Para `PERCENT`, en puntos básicos.
  percentBps       Int?
  /// Para `FIXED_AMOUNT`, en la unidad menor.
  amountMinor      Int?
  minSubtotalMinor Int           @default(0)
  startsAt         DateTime
  endsAt           DateTime
  isActive         Boolean       @default(true)

  orders Order[]
}

// ─── Carrito (§7.5, D3, C5) ─────────────────────────────────────────────────

/// Solo hay carritos de cuentas en el servidor; el de invitado vive en el navegador.
model Cart {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @unique @db.Uuid
  /// Idempotencia de la fusión: la misma `mergeKey` no vuelve a sumar.
  lastMergeKey String?   @db.Uuid
  mergedAt     DateTime?
  updatedAt    DateTime  @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]
}

/// Línea interna de almacenamiento: hasta 20 unidades (CHECK). El total del cliente no tiene tope
/// (regla C5); la API reparte el total en líneas de hasta 20.
model CartItem {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  cartId    String   @db.Uuid
  productId String   @db.Uuid
  quantity  Int
  createdAt DateTime @default(now())

  cart    Cart             @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product          @relation(fields: [productId], references: [id], onDelete: Restrict)
  options CartItemOption[]

  @@index([cartId])
}

model CartItemOption {
  cartItemId String @db.Uuid
  optionId   String @db.Uuid

  cartItem CartItem      @relation(fields: [cartItemId], references: [id], onDelete: Cascade)
  option   ProductOption @relation(fields: [optionId], references: [id], onDelete: Restrict)

  @@id([cartItemId, optionId])
}

// ─── Pedidos (§6.1, §6.2, §7.1) ─────────────────────────────────────────────

model Order {
  id                      String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code                    String          @unique
  userId                  String          @db.Uuid
  status                  OrderStatus     @default(PENDING_PAYMENT)
  fulfillmentType         FulfillmentType
  orderLocale             Locale
  currency                Currency
  currencyMinorUnits      Int
  subtotalMinor           Int
  discountMinor           Int             @default(0)
  deliveryFeeMinor        Int             @default(0)
  taxTotalMinor           Int
  /// Puede ser negativo: diferencia del redondeo al incremento de la moneda (§6.2, paso 6).
  roundingAdjustmentMinor Int             @default(0)
  totalMinor              Int
  pricesIncludeTax        Boolean
  deliveryZoneId          String?         @db.Uuid
  /// Copia de la dirección de entrega al crear el pedido.
  deliveryAddress         Json?
  contactPhone            String?
  customerNote            String?
  promotionId             String?         @db.Uuid
  /// Concurrencia optimista: `UPDATE … WHERE id = $1 AND version = $2` (§7.1).
  version                 Int             @default(0)
  expiresAt               DateTime?
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  user          User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveryZone  DeliveryZone?        @relation(fields: [deliveryZoneId], references: [id], onDelete: Restrict)
  promotion     Promotion?           @relation(fields: [promotionId], references: [id], onDelete: Restrict)
  items         OrderItem[]
  taxLines      OrderTaxLine[]
  statusHistory OrderStatusHistory[]
  payment       Payment?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/// Copia histórica del plato (D2). Hasta 20 unidades por línea interna (C5).
model OrderItem {
  id                   String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId              String  @db.Uuid
  productId            String? @db.Uuid
  orderLocale          Locale
  /// Nombre original del plato al momento del pedido.
  productName          String
  /// Nombre traducido si existía en el idioma del pedido.
  productNameLocalized String?
  quantity             Int
  unitPriceMinor       Int
  optionsTotalMinor    Int     @default(0)
  lineTotalMinor       Int

  order   Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  options OrderItemOption[]

  @@index([orderId])
}

model OrderItemOption {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderItemId     String  @db.Uuid
  optionId        String? @db.Uuid
  /// Etiquetas en el idioma del pedido y en es-CR para el admin (§4.5).
  groupLabel      String
  groupLabelEsCr  String
  label           String
  labelEsCr       String
  priceDeltaMinor Int

  orderItem OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([orderItemId])
}

/// Copia histórica del detalle fiscal (§6.2).
model OrderTaxLine {
  id               String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String  @db.Uuid
  taxRateId        String? @db.Uuid
  name             String
  rateBps          Int
  inclusive        Boolean
  taxableBaseMinor Int
  taxMinor         Int

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  taxRate TaxRate? @relation(fields: [taxRateId], references: [id], onDelete: SetNull)

  @@index([orderId])
}

model OrderStatusHistory {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String       @db.Uuid
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  actorUserId String?      @db.Uuid
  actorRole   RoleKey?
  reason      String?
  createdAt   DateTime     @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([orderId, createdAt])
}

// ─── Pagos (§7.2, §7.3, §7.4) ───────────────────────────────────────────────

/// Uno por pedido. Reembolsado ≤ capturado ≤ autorizado (CHECK).
model Payment {
  id                    String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId               String        @unique @db.Uuid
  method                PaymentMethod
  status                PaymentStatus
  currency              Currency
  amountAuthorizedMinor Int           @default(0)
  amountCapturedMinor   Int           @default(0)
  amountRefundedMinor   Int           @default(0)
  gatewayRef            String?
  version               Int           @default(0)
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  order      Order              @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts   PaymentAttempt[]
  operations PaymentOperation[]
  refunds    Refund[]
}

model PaymentAttempt {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String               @db.Uuid
  idempotencyKey String
  demoScenario   DemoScenario?
  result         PaymentAttemptResult
  failureCode    String?
  gatewayRef     String?
  createdAt      DateTime             @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([paymentId, createdAt])
}

/// Intención registrada antes de llamar al gateway; base de la reconciliación (§7.3).
model PaymentOperation {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String                 @db.Uuid
  type           PaymentOperationType
  status         PaymentOperationStatus
  /// Clave determinística (`paymentId:capture`, `refundId`…): reintentar nunca cobra dos veces.
  idempotencyKey String                 @unique
  amountMinor    Int
  gatewayRef     String?
  attempts       Int                    @default(0)
  lastError      String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([status, updatedAt])
}

model Refund {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId      String   @db.Uuid
  amountMinor    Int
  reason         String
  idempotencyKey String   @unique
  actorUserId    String   @db.Uuid
  createdAt      DateTime @default(now())

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  actor   User    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([paymentId])
}

/// Tablas del "procesador" simulado. El módulo de pagos nunca las lee directamente (§6.1).
model MockGatewayTransaction {
  id             String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ref            String               @unique
  idempotencyKey String               @unique
  amountMinor    Int
  currency       Currency
  state          MockTransactionState
  scenario       DemoScenario
  capturedMinor  Int                  @default(0)
  refundedMinor  Int                  @default(0)
  resolveAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

/// Idempotencia HTTP (§7.3). Única por `(scope, key)`.
model IdempotencyKey {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope          String
  key            String
  userId         String    @db.Uuid
  requestHash    String
  responseStatus Int?
  responseBody   Json?
  lockedUntil    DateTime?
  expiresAt      DateTime
  createdAt      DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([scope, key])
  @@index([expiresAt])
}

// ─── Correo y auditoría (§8.5, §8.6) ────────────────────────────────────────

/// Se inserta en la misma transacción que el evento; un worker lo envía después del commit.
model EmailOutbox {
  id                String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String?     @db.Uuid
  template          String
  to                String
  locale            Locale
  payload           Json
  status            EmailStatus @default(QUEUED)
  providerMessageId String?
  attempts          Int         @default(0)
  lastError         String?
  nextAttemptAt     DateTime    @default(now())
  sentAt            DateTime?
  createdAt         DateTime    @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
}

/// Solo inserción: el rol de la aplicación no tiene UPDATE ni DELETE y un trigger rechaza ambos
/// aunque alguien tenga permisos (§8.6).
model AuditLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorUserId String?  @db.Uuid
  actorRole   RoleKey?
  /// Por ejemplo `product.price_changed`.
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  reason      String?
  requestId   String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, createdAt])
}
