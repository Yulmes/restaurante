{
  "name": "@marea-baja/web",
  "version": "0.0.0",
  "private": true,
  "description": "Frontend de Marea Baja (React + React Router en modo framework + Vite + Tailwind).",
  "type": "module",
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "typegen": "react-router typegen",
    "typecheck": "npm run typegen && tsc -p tsconfig.json",
    "test:e2e": "playwright test",
    "capturas": "playwright test --grep @capturas",
    "glyphs": "node scripts/check-glyphs.ts",
    "hanko": "node scripts/extract-hanko.ts",
    "test:e2e:auth": "playwright test -c playwright.auth.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@react-router/dev": "7.18.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.5"
  },
  "dependencies": {
    "@fontsource/noto-sans": "5.3.0",
    "@fontsource/shippori-mincho-b1": "5.3.0",
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "@hookform/resolvers": "7.0.6",
    "@marea-baja/shared": "0.0.0",
    "@react-router/node": "7.18.4",
    "@tanstack/react-query": "5.107.1",
    "i18next": "26.5.11",
    "isbot": "5.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.92.0",
    "react-i18next": "17.1.9",
    "react-router": "7.18.4",
    "zod": "4.6.7"
  }
}
