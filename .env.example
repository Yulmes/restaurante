# Copiá este archivo a .env (que git ignora) y ajustá los valores si hace falta.
# Valores SOLO para desarrollo local. No son credenciales reales de ningún servicio.
# Referencia completa: ENVIRONMENT_VARIABLES.md

# --- API ---
NODE_ENV=development
# Rol de la aplicación: lee y escribe datos, no cambia el esquema ni edita el AuditLog (ADR 0003).
DATABASE_URL=postgresql://marea_app:marea_app_dev_local@localhost:5432/marea_baja

# --- API: servidor HTTP e identidad (M3) ---
API_PORT=3000
# Origen de la web: se exige en Origin (CSRF) y se usa en los enlaces de los correos.
PUBLIC_WEB_URL=http://127.0.0.1:5173
# Clave para los tokens CSRF de invitados y el hash de las IP. Valor solo de desarrollo.
APP_SECRET=marea-baja-solo-desarrollo-no-usar-en-produccion
# Correo: mailpit (local), resend (prueba de integración, D6) o memory (pruebas automáticas).
EMAIL_PROVIDER=mailpit
EMAIL_FROM=Marea Baja <no-reply@marea-baja.test>
MAILPIT_URL=http://127.0.0.1:8025
# Turnstile condicional (D8): fake en local y en CI; turnstile en producción con TURNSTILE_SECRET_KEY.
BOT_CHECK_PROVIDER=fake
TURNSTILE_GLOBAL_THRESHOLD=50
TURNSTILE_WINDOW_MINUTES=60

# --- Prisma (migraciones y semilla) ---
# Rol propietario del esquema. Solo lo usan la CLI de Prisma y los scripts de base de datos.
MIGRATION_DATABASE_URL=postgresql://marea:marea_dev_local@localhost:5432/marea_baja

# --- Docker Compose: PostgreSQL ---
POSTGRES_USER=marea
POSTGRES_PASSWORD=marea_dev_local
POSTGRES_DB=marea_baja
POSTGRES_PORT=5432

# --- Docker Compose: Mailpit (captura de correos en desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
