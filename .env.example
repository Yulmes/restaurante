# Copiá este archivo a .env (que git ignora) y ajustá los valores si hace falta.
# Valores SOLO para desarrollo local. No son credenciales reales de ningún servicio.
# Referencia completa: ENVIRONMENT_VARIABLES.md

# --- API ---
NODE_ENV=development
DATABASE_URL=postgresql://marea:marea_dev_local@localhost:5432/marea_baja

# --- Docker Compose: PostgreSQL ---
POSTGRES_USER=marea
POSTGRES_PASSWORD=marea_dev_local
POSTGRES_DB=marea_baja
POSTGRES_PORT=5432

# --- Docker Compose: Mailpit (captura de correos en desarrollo) ---
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
